{
  "name": "grr-web-beta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test src/services/*.test.ts",
    "typecheck": "tsc -b --pretty false",
